    "findings": [
      {
        "id": 35100,
        "kind": "written-dialogue",
        "quote": "종말을 맞으리라는 게 언제나 정해져 있었어",
        "reason": "일본어는 피할 수 없는 결말을 말하는 대사인데, 한국어의 복잡한 문어적 구성이 뒤의 자연스러운 구어와 어울리지 않는다.",
        "confidence": "medium"
      },
      {
        "id": 35139,
        "kind": "written-dialogue",
        "quote": "그들의 범죄에 당했어",
        "reason": "부하들에게 피해를 입었다는 영어와 일본어의 구어 대사에 비해 조사와 명사 조합이 부자연스럽다.",
        "confidence": "high"
      },
      {
        "id": 35246,
        "kind": "address",
        "quote": "반갑습니다, 부름받은 자(Beckoned)여!",
        "reason": "공손한 인사에 상대를 낮춰 부르는 ‘자여’를 바로 붙여 호칭과 존대가 어색하게 충돌한다.",
        "confidence": "medium"
      },
      {
        "id": 35269,
        "kind": "written-dialogue",
        "quote": "신화와 전설에 자리를 차지할 만큼",
        "reason": "전설적인 업적을 이야기하는 대사에서 ‘자리를 차지하다’와 결합한 조사가 부자연스럽다.",
        "confidence": "high"
      }
    ],
