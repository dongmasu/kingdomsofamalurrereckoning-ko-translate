    "findings": [
      {
        "id": 42516,
        "kind": "within-line",
        "quote": "우리 일행 네 명이야.",
        "reason": "영어와 일본어에서는 일행 네 명을 언급하는데, 한국어는 조사와 서술 관계가 어색해 뒤의 설명에 자연스럽게 이어지지 않는다.",
        "confidence": "high"
      },
      {
        "id": 42583,
        "kind": "written-dialogue",
        "quote": "저주로 고통받던 스카이스는 동족을 찾는 데 열중했다. 그래서 촛불의 전당을 만들었다.",
        "reason": "일본어는 촛불의 전당을 설명하는 발화인데, 한국어의 연속된 서술체와 문어적 표현은 뒤의 설명까지 기록문처럼 들린다.",
        "confidence": "medium"
      },
      {
        "id": 42654,
        "kind": "within-line",
        "quote": "다시 인양하러 가길 바랄 때 말해 줘.",
        "reason": "영어와 일본어는 화자에게 다시 인양을 보내고 싶을 때 알려 달라는 말인데, 한국어는 가는 주체가 불분명하고 '바랄 때'가 대화에서 어색하다.",
        "confidence": "high"
      }
