    "findings": [
      {
        "id": 43746,
        "kind": "written-dialogue",
        "quote": "날 괴로움에 내버려 둬",
        "reason": "혼자 고통을 견디게 해 달라는 영문과 일본어의 자연스러운 말투에 비해 한국어 결합이 어색하다.",
        "confidence": "high"
      },
      {
        "id": 43791,
        "kind": "within-line",
        "quote": "어서 오게, 사반트여. 무엇을 도와드릴까?",
        "reason": "같은 상대에게 하게체로 인사한 직후 높임 보조동사 ‘드리다’를 사용해 대우가 충돌한다. 일본어는 일관된 평어다.",
        "confidence": "high"
      },
      {
        "id": 43854,
        "kind": "written-dialogue",
        "quote": "넌 들어오자마자 아무렇지도 않게 작동을 멈췄어",
        "reason": "영문과 일본어에서는 상대가 칼날 장치의 작동을 해제하지만, 한국어는 상대 본인이 작동을 멈춘 것처럼 읽혀 구어 표현이 부자연스럽다.",
        "confidence": "high"
      },
      {
        "id": 43885,
        "kind": "written-dialogue",
        "quote": "나는... 버림받은 평원(Forsaken Plain)에 불쌍한 사람들이 있어",
        "reason": "원문의 머뭇거림을 살렸으나 ‘나는’이 뒤 문장과 연결되지 않아 말이 끊긴 자리 이상의 문장 어색함이 생긴다.",
        "confidence": "high"
      }
    ],
