    "findings": [
      {
        "id": 19122,
        "kind": "written-dialogue",
        "quote": "늘들 말했지",
        "reason": "영어와 일본어의 자연스러운 회상에 비해 조사와 부사가 결합된 표현이 어색해 구어의 흐름을 방해한다.",
        "confidence": "high"
      },
      {
        "id": 19123,
        "kind": "written-dialogue",
        "quote": "한계까지 부담을 지고 있어",
        "reason": "부상자로 도시가 감당하기 어려운 상황을 다급하게 말하는 대사인데, 이 표현은 결합이 어색하고 번역투로 들린다.",
        "confidence": "high"
      },
      {
        "id": 19190,
        "kind": "written-dialogue",
        "quote": "찾아라. 증거는 많지 않지만, 소문처럼 그녀가 옥티엔(Octienne)을 증오한다면 기꺼이 도와줄 것이다.",
        "reason": "일본어는 상대에게 직접 지시하고 전망을 말하는 구어인데, 한국어는 명령 뒤에 보고서 같은 문어체 서술이 이어져 대사가 경직된다.",
        "confidence": "medium"
      }
