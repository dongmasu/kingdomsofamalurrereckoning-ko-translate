    "findings": [
      {
        "id": 7200,
        "kind": "written-dialogue",
        "quote": "이 세계가 아는 가장 위대한 힘",
        "reason": "세계가 지금까지 알아 온 최대의 힘이라는 영문과 일문의 설명을 직역해, 구어 대사에서 표현이 부자연스럽다.",
        "confidence": "medium"
      },
      {
        "id": 7304,
        "kind": "within-line",
        "quote": "네가 이미 실력을 증명했더라도 말이야",
        "reason": "자신에게 기회가 왔다고 설명하는 대목에서 양보절을 덧붙인 방식이 어색해 말의 흐름이 끊긴다. 영문은 상대가 이미 실력을 입증한 상황과 대조하고 일문도 자신의 기회라는 점을 강조한다.",
        "confidence": "medium"
      },
      {
        "id": 7339,
        "kind": "address",
        "quote": "자네는 평생 보여 줄 만큼의 인내심을 이미 보여 줬어",
        "reason": "상대를 '자네'로 부르면서 같은 문장에서 해체 '보여 줬어'를 써 호칭과 종결의 높임 관계가 어긋난다. 일문은 같은 상대에게 일관된 평어로 말한다.",
        "confidence": "high"
      },
      {
        "id": 7379,
        "kind": "written-dialogue",
        "quote": "이 땅의 심장부에 투여해",
        "reason": "꽃 표본을 땅의 중심에 사용하는 지시인데, 한국어의 '투여해'가 장소를 직접 대상으로 삼아 대사에서 부자연스럽다. 영문과 일문은 각각 표본을 사용하거나 꽃을 가져가라고 말한다.",
        "confidence": "medium"
      }
