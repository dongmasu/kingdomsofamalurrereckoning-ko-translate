    "findings": [
      {
        "id": 41409,
        "kind": "written-dialogue",
        "quote": "그녀만이 우리가 숭배할 자격이 있어",
        "reason": "유일하게 숭배받을 만한 인물이라는 원문의 뜻에 비해 서술어의 주체가 어색해 대사가 매끄럽지 않다.",
        "confidence": "high"
      },
      {
        "id": 41412,
        "kind": "written-dialogue",
        "quote": "콜로사이(Kollossae)는 그들과 역사를 공유하고 있다. 그들에게 자비를 베푼 건 옳은 일이었다.",
        "reason": "자비를 베푼 판단을 말하는 일본어 구어에 비해 한국어 전체가 설명문처럼 딱딱하게 들린다.",
        "confidence": "medium"
      },
      {
        "id": 41414,
        "kind": "written-dialogue",
        "quote": "스카이스 마법으로만 울릴 수 있다",
        "reason": "종의 특성을 설명하는 일본어 구어에 비해 한국어 대사가 문어체 설명문처럼 들린다.",
        "confidence": "medium"
      },
      {
        "id": 41426,
        "kind": "written-dialogue",
        "quote": "그 검을 수리할 때 필요할 것이다",
        "reason": "검 수리에 필요한 밀랍을 직접 설명하는 일본어 구어에 비해 한국어는 사전식 설명과 문어적 추측으로 이어진다.",
        "confidence": "high"
      },
      {
        "id": 41540,
        "kind": "written-dialogue",
        "quote": "숲속의 조용한 굽이야",
        "reason": "조용한 숲속 장소를 소개하는 맥락에서 ‘숲속의 굽이’는 지형이나 장소를 가리키는 구어 표현으로 부자연스럽다.",
        "confidence": "high"
      }
    ],
