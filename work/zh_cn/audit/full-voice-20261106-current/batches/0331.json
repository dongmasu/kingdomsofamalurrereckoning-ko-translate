    "findings": [
      {
        "id": 59603,
        "kind": "written-dialogue",
        "quote": "반드시 처치하겠다고 맹세했다",
        "reason": "영어는 화자 자신의 맹세이고 일본어도 대화체인데, 한국어는 상황 보고문처럼 끝나 발화가 뻣뻣하다.",
        "confidence": "high"
      },
      {
        "id": 59641,
        "kind": "within-line",
        "quote": "누군가 널 지켜보고 있었다는 사실을 몰라야 했어",
        "reason": "상대가 감시 사실을 알아서는 안 됐다는 영어와 일본어의 대화 맥락에 비해 한국어 표현이 부자연스럽다.",
        "confidence": "high"
      },
      {
        "id": 59662,
        "kind": "within-line",
        "quote": "내 깨어 있는 시간을 낭비하러 왔나",
        "reason": "칭호를 사러 왔는지 빈정대는 말에서 영어 표현을 직역해 한국어 구어로 부자연스럽다.",
        "confidence": "high"
      },
      {
        "id": 59679,
        "kind": "within-line",
        "quote": "술 취한 얼간이 망신을 준 적이 없다고 말해 둬야겠군",
        "reason": "결투 상대를 조롱하는 영어와 일본어 맥락에서 ‘말해 둬야겠군’이 앞의 내용과 어색하게 결합한다.",
        "confidence": "medium"
      },
      {
        "id": 59701,
        "kind": "within-line",
        "quote": "장교를 전부 합친 수의 열 배보다도 더 많이 봤어",
        "reason": "병사와 장교를 얼마나 많이 보았는지 비교하는 대화인데, 수량 비교 구문이 부자연스러워 읽기 어렵다.",
        "confidence": "high"
      }
