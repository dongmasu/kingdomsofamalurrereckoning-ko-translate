        "identity": "Only child whose parents died long ago",
        "quote": "I am an only child, and both my parents passed long ago."
      },
      {
        "id": 25972,
        "identity": "Child of a merchant",
        "quote": "Perhaps I'll be a merchant like my father."
      },
      {
        "id": 26008,
        "identity": "Beckoned",
        "quote": "But I was Beckoned to this nature"
      },
      {
        "id": 26025,
        "identity": "Miner",
        "quote": "I have a great responsibility to my friends and fellow miners"
      },
      {
        "id": 26047,
        "identity": "Fateweaver",
        "quote": "And when a Fateweaver looks at your place in the weave, we see only the shapes of what you may choose to become."
