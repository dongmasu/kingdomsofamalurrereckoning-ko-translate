    "findings": [
      {
        "id": 22893,
        "kind": "politeness",
        "quote": "네가 그를 찾을 때까지 기다리겠어.",
        "reason": "일본어는 '見つかるでしょう／待っていましょう'로 정중한 거리를 유지한다. 영어·중국어에도 상대를 낮출 근거가 없는데, '네가'와 반말 종결로 상대를 친근하거나 아래로 대하는 관계로 바뀐다.",
        "confidence": "high"
      },
      {
        "id": 22922,
        "kind": "politeness",
        "quote": "시간이 나면 그녀를 직접 만나 보는 게 좋을 거야.",
        "reason": "일본어는 '知れません／時間がありましたら'로 공손하게 권유하며, 중국어도 '您'으로 상대를 높인다. 영어 역시 완곡한 제안인데 한국어는 친근한 반말 권유로 그 거리를 없앤다.",
        "confidence": "high"
      },
      {
        "id": 22931,
        "kind": "politeness",
        "quote": "우리가 할 수 있는 일은 해야 해.",
        "reason": "일본어는 두 문장 모두 '必要です／つのっています'의 정중한 설명체다. 영어·중국어는 병사 지원과 모금을 안내할 뿐 친밀한 관계를 제시하지 않는데, 한국어는 전반을 반말로 바꾸어 안내자의 대인 거리를 낮춘다.",
        "confidence": "medium"
      },
      {
        "id": 22986,
        "kind": "archaic",
        "quote": "문제가 있으면 내 부하 중 한 명을 찾아오게.",
        "reason": "일본어는 'まとめてるんだ／報告してくれ'의 일상적인 보통체다. 지휘관이라는 맥락은 있으나 영어의 'please'와 중국어의 '请'은 통상적인 요청이며, 한국어의 하게체는 상대를 아랫사람으로 대하는 고풍스러운 위계를 추가한다.",
        "confidence": "medium"
      },
      {
        "id": 23019,
        "kind": "politeness",
        "quote": "한때 그는 우리 사이에서 막강한 인물이었어.",
        "reason": "일본어는 'だったのですが／去ったのです'로 일관된 정중한 설명이다. 영어·중국어에도 청자와의 친밀성이나 하대 근거가 없는데 한국어는 '있었어／떠났지'로 바꾸어 공손한 대인 거리를 없앤다.",
        "confidence": "medium"
      },
      {
        "id": 23024,
        "kind": "politeness",
        "quote": "네가 옳은 일을 하지 않았다는 게... 실망스럽군.",
        "reason": "일본어는 '聞きました／そうですね／失望しています'와 'あなた'로 예의를 유지하며 질책한다. 영어·중국어도 실망을 표현할 뿐 하대를 지시하지 않는데, 한국어의 '네가'와 반말 종결은 상대를 내려다보는 질책으로 바꾼다.",
        "confidence": "high"
      }
